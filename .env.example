# Save this as .env in the app root, beside start.ps1 and requirements.lock.
# Enter secret values locally. Do not commit .env to Git or put it in frontend/.
# Restart FastAPI and refresh the browser after editing this file.

AI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://crunchweek.services.ai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
# Paste the key from this resource's deployment Details panel after the equals sign.
AZURE_OPENAI_API_KEY=4QLOriQB7RMWNBBZcN0SQ5h50rRPlGxxFNK4XpwbLSNjmhIvKyBRJQQJ99CJACfhMk5XJ3w3AAAAACOGls4X

# Notion sync: optional for AI extraction, required for sending your plan to Notion.
# Use your internal integration token. Grant read, insert and update content,
# and connect the integration to your chosen parent page in Notion.
NOTION_TOKEN=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
# Parent page ID (or its full Notion page URL).
NOTION_PARENT_PAGE_ID=

# Local app access.
ALLOWED_HOSTS=localhost,127.0.0.1

# Azure uses the v1 API; no OPENAI_API_KEY, API_VERSION, project ID,
# subscription ID, tenant ID, agent ID, or VITE_ secrets are needed.
# The app appends "responses" to the endpoint above; do not append it yourself.
