# Optional: the demo, manual entry, planning and downloads need no API keys.
# Copy to .env NEXT TO this file and start.ps1, not inside frontend/.
# Restart the backend and refresh the browser after changing .env.
# Foundry setup (deploy an Azure OpenAI model supporting Responses structured outputs):
AI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Endpoint example: https://your-resource.services.ai.azure.com/
# Or: https://your-resource.openai.azure.com/openai/v1/
# Deployment = the exact deployment NAME you chose, not the resource/project name.
# Do not use the project endpoint (.../api/projects/...). No API_VERSION is needed.

# Alternative: set AI_PROVIDER=openai and fill these instead of the Azure values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Notion: create an internal integration, grant read/insert/update content,
# and connect it to the parent page that will contain the semester database.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
# Keep local defaults unless deploying behind an authenticated reverse proxy.
ALLOWED_HOSTS=localhost,127.0.0.1
