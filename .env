
# ==========================================
# CRUNCH WEEK - MASTER ENVIRONMENT CONFIG
# ==========================================
# Save as .env in the app root beside
# start.ps1 and requirements.lock.
# Never commit this file to GitHub.
# Restart FastAPI after making changes.

# ==========================================
# 1. AI PROVIDER - AZURE OPENAI
# ==========================================
AI_PROVIDER=azure

AZURE_OPENAI_ENDPOINT=https://crunchweek.services.ai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_API_KEY=4QLOriQB7RMWNBBZcN0SQ5h50rRPlGxxFNK4XpwbLSNjmhIvKyBRJQQJ99CJACfhMk5XJ3w3AAAAACOGls4X

# ==========================================
# 2. ALTERNATIVE OPENAI PROVIDER
# ==========================================
# Not active while AI_PROVIDER=azure.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ==========================================
# 3. NOTION INTEGRATION
# ==========================================
# Internal integration token.
NOTION_TOKEN=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

# Parent page for semester planning.
NOTION_PARENT_PAGE_ID=3f4c6c7b305e80998117f106bba9308d

# ==========================================
# 4. LOCAL APPLICATION ACCESS
# ==========================================
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# 5. CONFIGURATION NOTES
# ==========================================
# Azure uses the v1 Responses API.
# The application appends "responses" to
# AZURE_OPENAI_ENDPOINT automatically.
#
# No API_VERSION, project ID, subscription
# ID, tenant ID or agent ID is needed.
#
# Do not place secrets in frontend/.
# Do not use VITE_ prefixes for secrets.
# ==========================================
